#!/usr/bin/env bash
#
# Atlas member-side committed-Cargo.lock-form guard (ADR-0021).
#
# Every local build under the Atlas root resolves through the stack `[patch]`
# overlay, which rewrites the member's Cargo.lock: first-party `source` lines
# are dropped and `[[patch.unused]]` tables appended. That rewrite is derived
# state. Committing it produces a lock that cannot resolve on a clean checkout,
# breaking every `--locked` CI step and `cargo publish` for that member.
#
# This hook rejects such a commit at the point the churn would escape. Install
# it once per clone from the Atlas root:
#
#   python scripts/atlas-lock-form.py install-hooks
#
# It is intentionally cheap: it exits immediately unless a Cargo.lock is
# staged.

set -e

if ! git diff --cached --name-only 2>/dev/null | grep -q 'Cargo\.lock$'; then
  exit 0
fi

repo="$(git rev-parse --show-toplevel)"
# <atlas>/repos/<member> -> <atlas>
atlas="$(cd "$repo/../.." && pwd)"
guard="$atlas/scripts/atlas-lock-form.py"
if [ ! -f "$guard" ]; then
  echo "[pre-commit] $guard not found; lock-form guard skipped" >&2
  exit 0
fi

python3 "$guard" staged --repo "$repo"
