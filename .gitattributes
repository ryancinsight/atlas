* text=auto
# Markdown PM artifacts carry very long lines; pin them to LF explicitly
# so text=auto's content heuristic cannot skip normalization and turn an
# edit into a whole-file line-ending diff.
*.md text eol=lf
*.sh text eol=lf
# Git hooks carry no extension, so `*.sh` misses them and `text=auto` would
# check them out CRLF on Windows, where the shebang then fails to resolve. A
# hook that cannot execute is a gate that does not gate.
.githooks/** text eol=lf
