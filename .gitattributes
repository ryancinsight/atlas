* text=auto
# Markdown PM artifacts carry very long lines; pin them to LF explicitly
# so text=auto's content heuristic cannot skip normalization and turn an
# edit into a whole-file line-ending diff.
*.md text eol=lf
*.sh text eol=lf
# Git hooks carry no extension, so `*.sh` misses them and `text=auto` would
# check them out CRLF on Windows, where the shebang then fails to resolve. A
# hook that cannot execute is a gate that does not gate.
.githooks/** text eol=lf
# The owned hook source lives outside `.githooks/`; same shebang rule.
scripts/git-hooks/** text eol=lf

# Parity snapshots carry raw SHA-256 digests and require byte-stable checkouts.
/docs/parity/** text eol=lf
/scripts/atlas-parity.py text eol=lf
/scripts/atlas_parity*.py text eol=lf
/scripts/parity/** text eol=lf
/scripts/tests/test_atlas_parity.py text eol=lf
/scripts/tests/test_parity_reference_extractors.py text eol=lf
