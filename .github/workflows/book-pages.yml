name: Build and deploy the package book

# Atlas owns the book publication pipeline once for the whole stack (ADR 0035).
# Package repositories call this workflow instead of copying it: the four
# existing per-repo copies were identical apart from the built output directory.
#
# The book is the pedagogical documentation layer — field theory, then numerical
# method, then the crate's abstractions mapped onto that theory. Rustdoc remains
# the item-contract layer and is published separately. Deployment uses the Pages
# artifact flow under OIDC, so no gh-pages branch and no deploy key exist.
#
# Enable Pages once per repository under
# Settings -> Pages -> Source: GitHub Actions.

on:
  workflow_call:
    inputs:
      book-path:
        description: Book source directory containing book.toml
        required: false
        default: docs/book
        type: string
      output-path:
        description: >-
          Built HTML directory produced by mdbook, relative to the repository
          root. Read this from the book's build-dir setting rather than guessing.
        required: true
        type: string
      mdbook-version:
        description: Exact mdBook release used to build the book
        required: false
        default: "0.5.4"
        type: string
      mdbook-test:
        description: >-
          Run `mdbook test` so book code samples cannot rot. Requires the book's
          samples to compile against the package. Each book flips this to true
          as its samples become testable; see ADR 0035 for the adoption ledger.
        required: false
        default: false
        type: boolean
      rust-toolchain:
        description: Toolchain used by `mdbook test`; ignored when mdbook-test is false
        required: false
        default: "stable"
        type: string
      cargo-package:
        description: >-
          Cargo package name to build before running `mdbook test`. When set,
          the workflow builds the package first so that `mdbook test` can
          resolve the crate in fenced code blocks. Ignored when mdbook-test
          is false.
        required: false
        default: ""
        type: string
      cargo-crate:
        description: >-
          Rust library target name to stage for `mdbook test`. Set this when
          the library target name differs from the Cargo package name; when
          omitted, the workflow converts package hyphens to underscores.
        required: false
        default: ""
        type: string
      mdbook-linkcheck2-version:
        description: >-
          Exact `mdbook-linkcheck2` version to install. Set this when the
          book's `book.toml` declares an `[output.linkcheck2]` backend: mdbook
          fails the render outright when a declared backend is missing, so the
          binary has to be present rather than optional.
        required: false
        default: ""
        type: string
      atlas-ref:
        description: >-
          Exact Atlas commit owning the provider gitlink graph. Set only when
          `mdbook test` must compile against Atlas path dependencies.
        required: false
        default: ""
        type: string
      manifest:
        description: Manifest scanned for path dependencies when atlas-ref is set
        required: false
        default: Cargo.toml
        type: string

permissions:
  contents: read

jobs:
  build:
    name: Build book
    runs-on: ubuntu-latest
    # Cold: toolchain and mdBook installs, an apt fetch, a workspace compile,
    # then mdbook test and build. Warm, it is a few minutes; the bound covers
    # the cold case so a cache miss degrades to slow rather than to red.
    timeout-minutes: 25
    env:
      # Keep every network/compiler subprocess below the job bound. A hung
      # package manager or documentation sample must terminate with a useful
      # failure instead of consuming the runner until the job timeout.
      BOOK_COMMAND_TIMEOUT: 8m
      BOOK_NETWORK_TIMEOUT: 5m
      # Compiling the caller's package is the one step whose honest duration is
      # a workspace compile, not a package fetch. Sharing the 8m network guard
      # with it killed kwavers mid-`rustc` at exit 124 -- a hang guard applied
      # to something that was not hanging. Derived from the 25m job bound less
      # the installs and the book build itself; a warm cache puts the real
      # figure an order below it, and crossing it is a compile-time defect to
      # investigate, not a number to raise.
      BOOK_BUILD_TIMEOUT: 12m
    steps:
      - name: Check out the book source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Configure Pages
        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5.0.0

      - name: Install mdBook
        shell: bash
        env:
          MDBOOK_VERSION: ${{ inputs.mdbook-version }}
        run: |
          set -euo pipefail
          timeout --foreground --kill-after=30s "$BOOK_NETWORK_TIMEOUT" \
            curl --fail --location --silent --show-error \
            --connect-timeout 30 --max-time 300 \
            "https://github.com/rust-lang/mdBook/releases/download/v${MDBOOK_VERSION}/mdbook-v${MDBOOK_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
            --output mdbook.tar.gz
          tar -xzf mdbook.tar.gz
          echo "$PWD" >> "$GITHUB_PATH"
          export PATH="$PWD:$PATH"
          mdbook --version

      - name: Install the pinned Rust toolchain for linkcheck2
        if: inputs.mdbook-linkcheck2-version != ''
        uses: dtolnay/rust-toolchain@4cda84d5c5c54efe2404f9d843567869ab1699d4 # stable
        with:
          toolchain: stable

      - name: Install mdbook-linkcheck2
        if: inputs.mdbook-linkcheck2-version != ''
        shell: bash
        env:
          LINKCHECK2_VERSION: ${{ inputs.mdbook-linkcheck2-version }}
        run: |
          set -euo pipefail
          timeout --foreground --kill-after=30s "$BOOK_COMMAND_TIMEOUT" \
            cargo install mdbook-linkcheck2 --version "$LINKCHECK2_VERSION" --locked
          mdbook-linkcheck2 --version

      - name: Check out exact Atlas path dependencies
        if: inputs.mdbook-test && inputs.atlas-ref != ''
        uses: ryancinsight/atlas/.github/actions/checkout-path-dependencies@cd6a78e8c9a9816b0fa5ff22ad9166edbb713894
        with:
          manifest: ${{ inputs.manifest }}
          destination: ..
          atlas_ref: ${{ inputs.atlas-ref }}

      - name: Install the pinned Rust toolchain
        if: inputs.mdbook-test
        uses: dtolnay/rust-toolchain@4cda84d5c5c54efe2404f9d843567869ab1699d4 # stable
        with:
          toolchain: ${{ inputs.rust-toolchain }}

      # Without this the book job compiles the caller's workspace from cold on
      # every run. On a large workspace that exceeds BOOK_COMMAND_TIMEOUT and
      # the job dies at exit 124 mid-compile, which reads as a book failure and
      # blocks merges that never touched the book. Restoring artifacts is the
      # fix; raising the timeout would only absorb the growth.
      #
      # `save-if` restricts writes to the caller's default branch, so pull
      # requests restore but cannot evict each other's entries. The cache is
      # scoped to the calling repository, so members do not share entries.
      - name: Restore the Rust build cache
        if: inputs.mdbook-test
        uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.8.1
        with:
          shared-key: book-pages
          save-if: ${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
          # A cold workspace can exceed the build bound on its first run. Saving
          # what it compiled lets the next run finish instead of restarting from
          # nothing every time, which is the state that made this job unpassable.
          cache-on-failure: true

      - name: Install native fontconfig headers
        if: inputs.mdbook-test
        shell: bash
        run: |
          set -euo pipefail
          timeout --foreground --kill-after=30s "$BOOK_COMMAND_TIMEOUT" \
            sudo apt-get update
          timeout --foreground --kill-after=30s "$BOOK_COMMAND_TIMEOUT" \
            sudo apt-get install --yes libfontconfig1-dev

      - name: Build package for book code sample testing
        if: inputs.mdbook-test && inputs.cargo-package != ''
        shell: bash
        run: |
          set -euo pipefail
          timeout --foreground --kill-after=30s "$BOOK_BUILD_TIMEOUT" \
            cargo build --locked -p "${{ inputs.cargo-package }}"
          # Package and library target names usually differ only by hyphens,
          # but a package may expose an explicit [lib] name.
          pkg="${{ inputs.cargo-package }}"
          crate="${{ inputs.cargo-crate }}"
          if [[ -z "$crate" ]]; then
            crate="${pkg//-/_}"
          fi
          target_dir="$(timeout --foreground --kill-after=30s 2m \
            cargo metadata --locked --no-deps --format-version 1 | \
            python3 -c "import json,sys; print(json.load(sys.stdin)['target_directory'])")"
          deps_dir="$target_dir/debug/deps"
          if compgen -G "$deps_dir/lib${crate}-*.rlib" > /dev/null; then
            # mdbook 0.5.4 does not forward RUSTDOCFLAGS: it spawns rustdoc with
            # a fixed argument list, so `--extern` cannot be injected. Point
            # `mdbook test --library-path` at a fresh directory containing the
            # Cargo artifacts with their metadata hashes intact; rustdoc uses
            # those hashes to select the dependency version recorded by the
            # package rlib. Fenced blocks must declare the crate with
            # `extern crate <name>;`.
            #
            # Dependencies are staged alongside the package itself: a chapter
            # that demonstrates a real workflow routinely names a second crate
            # (`extern crate bytemuck;` beside `extern crate eunomia;`), and
            # staging only the package leaves that block failing E0463 with no
            # way for the chapter to fix it.
            stage_dir="$target_dir/mdbook-test-libs"
            rm -rf "$stage_dir"
            mkdir -p "$stage_dir"
            # Proc-macro crates build as dynamic libraries rather than rlibs, so
            # both extensions are staged: a derive macro reached through a
            # dependency (bytemuck_derive via bytemuck) fails E0463 otherwise.
            # Do not strip the metadata hash or select by directory order: a
            # locked graph may contain multiple versions of one crate, and a
            # hashless first match can produce E0460 for the package itself.
            staged=0
            for candidate in "$deps_dir"/lib*.rlib "$deps_dir"/lib*.so; do
              [[ -e "$candidate" ]] || continue
              base="$(basename "$candidate")"
              cp -f "$candidate" "$stage_dir/$base"
              staged=$((staged + 1))
            done
            if (( staged == 0 )); then
              echo "cargo build produced no linkable artifacts in $deps_dir" >&2
              exit 1
            fi
            echo "MDBOOK_TEST_LIB_DIR=${stage_dir}" >> "$GITHUB_ENV"
          fi

      - name: Test book code samples
        if: inputs.mdbook-test
        shell: bash
        run: |
          set -euo pipefail
          if [[ -n "${MDBOOK_TEST_LIB_DIR:-}" ]]; then
            timeout --foreground --kill-after=30s "$BOOK_COMMAND_TIMEOUT" \
              mdbook test "${{ inputs.book-path }}" --library-path "$MDBOOK_TEST_LIB_DIR"
          else
            timeout --foreground --kill-after=30s "$BOOK_COMMAND_TIMEOUT" \
              mdbook test "${{ inputs.book-path }}"
          fi

      - name: Build book
        shell: bash
        env:
          BOOK_PATH: ${{ inputs.book-path }}
          OUTPUT_PATH: ${{ inputs.output-path }}
        run: |
          set -euo pipefail
          timeout --foreground --kill-after=30s "$BOOK_COMMAND_TIMEOUT" \
            mdbook build "$BOOK_PATH"
          if [[ ! -f "$OUTPUT_PATH/index.html" ]]; then
            echo "mdbook produced no $OUTPUT_PATH/index.html; check the book's build-dir against the output-path input" >&2
            exit 1
          fi

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@7b1f4a764d45c48632c6b24a0339c27f5614fb0b # v4.0.0
        with:
          path: ${{ inputs.output-path }}

  deploy:
    if: github.event_name != 'pull_request'
    needs: build
    name: Deploy to GitHub Pages
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5
