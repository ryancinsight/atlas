#!/usr/bin/env bash
#
# Atlas hook trampoline (ATLAS-HOOKS-FOLLOW-CHECKOUT-2026-09-18).
#
# `core.hooksPath=.githooks` resolves inside the working tree, so the gate
# that actually runs on a push is whatever branch the tree happens to have
# checked out -- under concurrent agents sharing one tree, routinely a
# peer's. On 2026-09-18 the tree held `foundation-f3-correction-2026-09-10`,
# whose `.githooks/pre-push` predated a pushed-range fix; three pushes of
# main-based branches were refused for a moirai pin they never touched, and
# were pushed through only via a transient `-c core.hooksPath` override.
#
# This prelude makes the default branch's committed copy of this same file
# authoritative regardless of what is checked out: it compares the bytes of
# the file actually executing -- `${BASH_SOURCE[0]}`, captured before any
# re-exec, so this holds even when `core.hooksPath` points somewhere other
# than the checkout's own `.githooks/` (a transient override, a member
# clone, or any other layout) -- against `origin/HEAD:.githooks/pre-push`,
# falling back to `origin/main` when `origin/HEAD` is unset, hashed the way
# `git hash-object` would stage it so line-ending filters do not cause false
# mismatches. On any difference it execs that blob's content instead of
# continuing, passing argv and stdin straight through (stdin carries git's
# ref-update protocol lines, read further down). When the two already match
# -- the ordinary case, since this prelude ships as part of the very file it
# guards -- there is nothing to fetch and execution falls through to the
# gate below in the same process. A stale checkout that already carries some
# version of this same prelude therefore self-corrects the moment its
# content diverges from origin's default branch, without anyone re-running
# `git config`.
#
# Fails closed: an unresolvable origin ref or a missing blob refuses the
# push rather than silently running whatever this checkout happens to hold.
#
# Cost: one local ref lookup and one blob read per push, both against the
# already-fetched remote-tracking ref -- no network beyond what the push
# itself performs.
#
# The re-exec'd content is this same file, so it re-defines and re-runs this
# same prelude. Its `${BASH_SOURCE[0]}` is now the process-substitution file
# descriptor bash exec'd (`/dev/fd/NN` on POSIX shells), never the on-disk
# hook path -- so this second pass must not repeat the comparison against
# that descriptor, and nothing downstream may derive a filesystem path from
# `BASH_SOURCE`/`$0` either, since both resolve to the same transient
# descriptor after the exec (`atlas_root` below uses `git rev-parse
# --show-toplevel` for exactly this reason). Without a way to say "already
# resolved", a second comparison pass would also find the same mismatch and
# re-exec forever. `_ATLAS_HOOK_TRAMPOLINE_DEFERRED` is that marker: set
# only immediately before the exec below, inherited by the child, and
# checked first on every entry.
_atlas_hook_trampoline() {
    [ -n "${_ATLAS_HOOK_TRAMPOLINE_DEFERRED:-}" ] && return 0

    local hook_path=".githooks/pre-push"
    local root ref blob_sha self_sha self_path

    # Captured before anything below can re-exec: on the first pass this is
    # the on-disk hook git (or this test harness) actually invoked, whatever
    # `core.hooksPath` names -- exactly the file whose bytes must match
    # origin's. On a re-exec'd pass (guarded above) this line never runs.
    self_path="${BASH_SOURCE[0]}"

    # Git Bash on Windows mangles a `ref:path` argument that contains `/` --
    # MSYS's argv-to-native-path heuristic rewrites it to `ref\path` (and `:`
    # to `;`) before exec'ing git.exe, so the revision never resolves.
    # `local -x` scopes the export to this function's dynamic extent, so it
    # never leaks into the gate below when the checkout is already current.
    local -x MSYS_NO_PATHCONV=1

    root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        echo "pre-push: BLOCKED -- not inside a git work tree; the committed" >&2
        echo "default-branch hook cannot be resolved." >&2
        return 1
    }

    ref="$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
    [ -n "$ref" ] || ref="origin/main"

    if ! blob_sha="$(git -C "$root" rev-parse --verify --quiet "${ref}:${hook_path}" 2>/dev/null)"; then
        echo "pre-push: BLOCKED -- ${ref}:${hook_path} does not resolve, so the" >&2
        echo "default branch's committed hook is unavailable. Fetch origin, or" >&2
        echo "confirm ${ref} exists, before pushing." >&2
        return 1
    fi

    self_sha="$(git -C "$root" hash-object "$self_path" 2>/dev/null)" || self_sha=""
    if [ "$self_sha" = "$blob_sha" ]; then
        return 0
    fi

    export _ATLAS_HOOK_TRAMPOLINE_DEFERRED=1
    exec bash <(git -C "$root" cat-file -p "$blob_sha") "$@"
}

_atlas_hook_trampoline "$@" || exit 1

#
# Atlas gitlink coherence gate.
#
# The recorded gitlink is the reproducible stack revision, so it must name a
# commit that is reachable from the member's published default branch. Twice in
# two days it did not: `repos/leto` was recorded at `a8d9ae93`, the tip of an
# unmerged `perf/leto-matmul-parity-verdict`, once by each of two sessions. Both
# times the cause was the same — `git add repos/<name>` stages the submodule's
# *worktree HEAD*, and under concurrent agents that HEAD is routinely a peer's
# in-flight branch.
#
# `tools/gitlink-coherence` already detects exactly this (it calls it
# category B: "pin reachable from a remote ref other than origin/main") and
# already exits 1 on any defect. It was wired into nothing. This hook is the
# wiring.
#
# Why pre-push and not pre-commit: the auditor reads the gitlinks from HEAD, so
# at pre-commit time it would judge the previous commit, not the one being
# made. Pre-push is also the point where a bad pin would become everyone
# else's problem.
#
# Enable once per clone (same switch as the pre-commit gate):
#
#   git config core.hooksPath .githooks
#
# The auditor uses local refs and does not fetch, so this costs no network.

set -uo pipefail

# Not `dirname "${BASH_SOURCE[0]}"`: when the trampoline above re-execs this
# file's content via process substitution, `${BASH_SOURCE[0]}` here is the
# process-substitution descriptor (`/dev/fd/NN`), not this file's on-disk
# path, and every path derived from it -- including the auditor's own
# manifest path -- resolved under `/dev`. Git sets a hook's working
# directory to the top of the work tree before invoking it (true for both
# the first invocation and the re-exec'd one, since `exec` never changes
# cwd), so asking git directly is the one derivation immune to how this
# file got run.
atlas_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$atlas_root" ]; then
    echo "pre-push: BLOCKED -- not inside a git work tree; the gitlink" >&2
    echo "auditor and its related paths cannot be resolved." >&2
    exit 1
fi
binary="${atlas_root}/target/release/gitlink-coherence"
[ -x "${binary}.exe" ] && binary="${binary}.exe"

if [ ! -x "$binary" ]; then
    # The auditor lives in a gitignored target tree, so a clean checkout or a
    # cache eviction removes it without touching a tracked file. Build it here
    # rather than reporting its absence: an absent checker must not be the
    # difference between a gate and a decoration.
    echo "pre-push: gitlink auditor not built — building it now." >&2
    # Build from outside the stack root on purpose. Cargo discovers config from
    # the working directory upward, so building under `atlas_root` applies the
    # stack `[patch]` overlay, whose resolution the committed lockfile does not
    # describe — `--locked` then fails, and without it the overlay rewrites the
    # lockfile and dirties the tree on every push. Outside the overlay the lock
    # resolves standalone, which is the state the lockfile actually records.
    # CARGO_TARGET_DIR must therefore be explicit, since the overlay is also
    # what would otherwise supply the shared target path.
    ( cd "$HOME" 2>/dev/null || cd / ; \
      CARGO_TARGET_DIR="${atlas_root}/target" cargo build --release --locked \
          --manifest-path "${atlas_root}/tools/gitlink-coherence/Cargo.toml" ) >&2
    binary="${atlas_root}/target/release/gitlink-coherence"
    [ -x "${binary}.exe" ] && binary="${binary}.exe"
fi

if [ ! -x "$binary" ]; then
    # Fail closed. This previously exited 0, which is a silent skip in every
    # way that matters: the push proceeded ungated, and the two defects the
    # comment above cites are exactly what an ungated push lands. A gate that
    # cannot run blocks; it does not wave the change through.
    echo "pre-push: BLOCKED — the gitlink auditor is unavailable and could not" >&2
    echo "be built, so the coherence gate cannot run. Build it manually with" >&2
    echo "  cargo build --release --manifest-path tools/gitlink-coherence/Cargo.toml" >&2
    echo "or push with --no-verify only if you have verified the pins by hand." >&2
    exit 1
fi

# The revisions being pushed, from git's stdin protocol. HEAD is whatever
# branch the shared tree happens to hold -- under concurrent agents routinely a
# peer's -- so a gate that reads HEAD judges the wrong commit: one push of a
# main-based branch was refused for a gitlink a peer's checked-out branch had
# moved. Each gate below judges the pushed tip.
pushed_tips=()
pushed_bases=()
if [ ! -t 0 ]; then
    while read -r _local_ref local_sha _remote_ref remote_sha; do
        [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
        pushed_tips+=("$local_sha")
        pushed_bases+=("$remote_sha")
    done
fi
if [ "${#pushed_tips[@]}" -eq 0 ]; then
    pushed_tips=(HEAD)
    pushed_bases=("0000000000000000000000000000000000000000")
fi
# The base each gate diffs against: the remote tip being replaced, or for a
# new branch its merge-base with the default -- never the checked-out
# branch's upstream, which belongs to whatever a peer holds in the tree.
gate_base_for() {
    local tip="$1" remote="$2" base
    if [ "$remote" != "0000000000000000000000000000000000000000" ]; then
        if git -C "$atlas_root" cat-file -e "$remote^{commit}" 2>/dev/null; then
            printf '%s' "$remote"
            return 0
        fi
    fi
    base="$(git -C "$atlas_root" merge-base origin/main "$tip" 2>/dev/null || true)"
    printf '%s' "$base"
}

report="$("$binary" --atlas-root "$atlas_root" 2>&1)"
status=$?

# Second stage, and only for a push that moves a pin: a gitlink can name a
# published commit -- everything the auditor checks -- and still import debt
# the member grew since the last advance. That is the loop this exists to
# break; every ratchet regression traced today was found after the pin moved,
# never before. `check --revision <tip>` scans each moved member at the
# gitlink the pushed tip records -- never the member's live checkout, which in
# a shared tree holds whatever a peer left there -- and `--repo` keeps the scan
# to the members that actually changed, so an ordinary push costs nothing and
# an advance costs about ten seconds per moved member.
debt_gate() {
    local tip="$1" changed python_bin member output base
    # A branch on its first push has no upstream, and that is exactly when
    # a pin advance is most likely; falling through to "nothing changed"
    # there would skip the gate on the pushes it most needs to see.
    base="$gate_base"
    [ -z "$base" ] && return 0
    changed="$(git -C "$atlas_root" diff --name-only "$base".."$tip" -- repos/ 2>/dev/null | awk -F/ 'NF > 1 { print $2 }' | sort -u)"
    [ -z "$changed" ] && return 0

    python_bin="${PYTHON:-}"
    if [ -z "$python_bin" ]; then
        for candidate in python3 python; do
            if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1; then
                python_bin="$candidate"
                break
            fi
        done
    fi
    if [ -z "$python_bin" ]; then
        echo "pre-push: BLOCKED -- gitlinks moved and no python interpreter is" >&2
        echo "available, so the debt they carry is unmeasured." >&2
        return 1
    fi

    for member in $changed; do
        [ -d "${atlas_root}/repos/${member}" ] || continue
        if ! output="$(unset GIT_DIR GIT_WORK_TREE; "$python_bin" \
                "${atlas_root}/scripts/atlas-conformance.py" \
                check --repo "$member" --revision "$tip" 2>&1)"; then
            echo "pre-push: BLOCKED -- advancing ${member} raises a debt class." >&2
            echo "$output" >&2
            echo >&2
            echo "pre-push: fix it in ${member} and advance the pin to the fix, or" >&2
            echo "push with --no-verify if the raise is deliberate and recorded." >&2
            return 1
        fi
    done
    return 0
}

# Atlas's own PM boards and tracked images, under the same budget gate the
# members run (scripts/atlas-artifact-budget.py): an over-budget board may
# not grow, an oversized image may not be added or touched.
budget_gate() {
    local tip="$1" base python_bin candidate
    base="$gate_base"
    python_bin="${PYTHON:-}"
    if [ -z "$python_bin" ]; then
        for candidate in python3 python; do
            command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1 && { python_bin="$candidate"; break; }
        done
    fi
    if [ -z "$python_bin" ]; then
        echo "pre-push: BLOCKED -- no python interpreter; artifact budgets unverified." >&2
        return 1
    fi
    local args=()
    [ -n "$base" ] && args=(--base "$base")
    # The checker comes from the revision being pushed, so a shared tree that
    # lacks or predates it (a peer's checkout) still judges by the right code;
    # a revision without the script predates the gate and has nothing to run.
    if ! git -C "$atlas_root" cat-file -e "$tip:scripts/atlas-artifact-budget.py" 2>/dev/null; then
        return 0
    fi
    git -C "$atlas_root" show "$tip:scripts/atlas-artifact-budget.py"         | "$python_bin" - check --root "$atlas_root" --rev "$tip" "${args[@]}"         || { echo "pre-push: BLOCKED -- a board grew past its budget or an oversized image was added." >&2; return 1; }
    return 0
}

# Credentials in the lines the push adds (scripts/atlas-secret-scan.py): a
# secret that reaches a remote is published, so the scan runs before the push
# rather than in CI. The scanner comes from the pushed revision, as the budget
# checker does.
secret_gate() {
    local tip="$1" base python_bin candidate
    base="$gate_base"
    python_bin="${PYTHON:-}"
    if [ -z "$python_bin" ]; then
        for candidate in python3 python; do
            command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1 && { python_bin="$candidate"; break; }
        done
    fi
    if [ -z "$python_bin" ]; then
        echo "pre-push: BLOCKED -- no python interpreter; the pushed range was not scanned for credentials." >&2
        return 1
    fi
    if ! git -C "$atlas_root" cat-file -e "$tip:scripts/atlas-secret-scan.py" 2>/dev/null; then
        return 0
    fi
    local args=()
    [ -n "$base" ] && args=(--base "$base")
    git -C "$atlas_root" show "$tip:scripts/atlas-secret-scan.py" \
        | "$python_bin" - check --root "$atlas_root" --rev "$tip" "${args[@]}" \
        || { echo "pre-push: BLOCKED -- the push adds a credential; remove it from every commit and rotate it if it ever reached a remote." >&2; return 1; }
    return 0
}

# No committed tool may write another repository's refs into the shared
# remote-tracking namespace (scripts/atlas-refspec-guard.py): a loaded pin
# sweep did exactly that on 2026-09-21 and masqueraded as atlas's own
# published origin. Fetching a member ref lands in refs/scratch/ or in
# FETCH_HEAD; only the own-origin wildcard mirror touches refs/remotes/.
refspec_gate() {
    local tip="$1" python_bin candidate
    python_bin="${PYTHON:-}"
    if [ -z "$python_bin" ]; then
        for candidate in python3 python; do
            command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1 && { python_bin="$candidate"; break; }
        done
    fi
    if [ -z "$python_bin" ]; then
        echo "pre-push: BLOCKED -- no python interpreter; refspec guard unverified." >&2
        return 1
    fi
    if ! git -C "$atlas_root" cat-file -e "$tip:scripts/atlas-refspec-guard.py" 2>/dev/null; then
        return 0
    fi
    git -C "$atlas_root" show "$tip:scripts/atlas-refspec-guard.py"         | "$python_bin" - check --root "$atlas_root" --rev "$tip"         || { echo "pre-push: BLOCKED -- a committed tool maps a fetched ref onto a remote-tracking ref; only the own-origin wildcard mirror may." >&2; return 1; }
    return 0
}

case "$status" in
    0)
        for i in "${!pushed_tips[@]}"; do
            tip="${pushed_tips[$i]}"
            gate_base="$(gate_base_for "$tip" "${pushed_bases[$i]}")"
            debt_gate "$tip" || exit 1
            budget_gate "$tip" || exit 1
            secret_gate "$tip" || exit 1
            refspec_gate "$tip" || exit 1
        done
        exit 0
        ;;
    1)
        echo "pre-push: BLOCKED — a recorded gitlink does not name a published commit." >&2
        echo "$report" >&2
        echo >&2
        echo "pre-push: a gitlink must name a commit reachable from the member's" >&2
        echo "origin default branch. Set it from the ref rather than from a" >&2
        echo "worktree HEAD, then confirm:" >&2
        echo "  SHA=\$(git -C repos/<name> rev-parse origin/<default>)" >&2
        echo "  git update-index --cacheinfo 160000,\$SHA,repos/<name>" >&2
        echo "  git ls-tree HEAD repos/<name>   # must match \$SHA" >&2
        exit 1
        ;;
    *)
        # Fail closed. This arm used to let the push through, reasoning that
        # the gate should not become a new way for pushes to fail. It became
        # the way a defect got through instead: a gitlink naming a commit that
        # does not exist in the member at all made `merge-base` exit 128, the
        # auditor reported that as an invocation error, and this arm waved the
        # push on -- landing the one pin class the gate exists to stop. The
        # auditor now classifies that case itself, but an audit that could not
        # run has judged nothing, and nothing judged is not a pass.
        echo "pre-push: BLOCKED -- the gitlink auditor could not complete (exit ${status})," >&2
        echo "so the recorded pins are unverified." >&2
        echo "$report" >&2
        echo >&2
        echo "pre-push: fix the reported plumbing state and push again, or push with" >&2
        echo "--no-verify only after verifying every changed pin by hand:" >&2
        echo "  git -C repos/<name> cat-file -e \$(git rev-parse HEAD:repos/<name>)^{commit}" >&2
        exit 1
        ;;
esac
