#!/usr/bin/env bash
#
# Atlas docs dead-link check (STRICT mode, §7 #5 LANDED).
#
# Scans every repos/*/docs/book/ directory (all provider books — 24 as of
# 2026-08-11; ATLAS-BOOK-LINK-CI-001 extended the gate from the original
# four physics books to the whole stack) for broken inline links via
# scripts/check_mdbook_links.py.  Exits non-zero on any FILE_MISSING —
# BLOCKS commits that introduce new broken links.  See
# docs/mdbook/detector-parity.md §7 #5 for the flip rationale.
#
# This hook is version-controlled so every clone runs the same gate. Enable it
# once per clone with:
#
#   git config core.hooksPath .githooks
#
# A hook kept only in .git/hooks/ is local to one machine, so a fix to it
# reaches nobody. Keep this file as the single source and never edit the copy
# under .git/hooks/.

set -e

# The canonical-stack-root resolver, shared with .githooks/pre-push. A hook
# started by a Windows path keeps its backslashes in BASH_SOURCE.
hook_path="${BASH_SOURCE[0]//\\//}"
hook_dir="${hook_path%/*}"
[ "$hook_dir" != "$hook_path" ] || hook_dir=.
. "$hook_dir/stack-root.sh" || {
  echo "pre-commit: BLOCKED -- cannot read $hook_dir/stack-root.sh." >&2
  exit 1
}

# Locate the work-tree root.  Skip cleanly if no git context (e.g. dry-run).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  echo "[pre-commit] not inside a git work-tree; skipping docs check" >&2
  exit 0
fi
cd "$ROOT"

# ---------------------------------------------------------------------------
# Board and pointer hygiene (gap-audit 2026-08-24 patterns 1-4).
#
# Board and gitlink updates have separate review boundaries:
#
#   R2  A board sync travels alone: no submodule pointers, no lockfiles.
#       Pointer advances landed under a docs-audit message (df9042208) and
#       a lockfile sweep rode a docs commit in coeus.
#
#   R3  A submodule pointer advance travels alone too - the mirror of R2 -
#       because mixing pointer deltas with content makes bisect and revert
#       ambiguous about which moved the build.

# Every process costs a fork and an exec, which Git for Windows emulates
# slowly and a loaded host slows further, so the hook reads each fact once
# and does string work in bash itself.
# A failing `git diff --cached` ends the hook (set -e): an index it cannot
# read must not pass the checks below.
staged_paths="$(git diff --cached --name-only)"
staged() { [ -z "$staged_paths" ] || printf '%s\n' "$staged_paths"; }

board_staged="$(grep -E '^(backlog|checklist)\.md$' <<<"$staged_paths" || true)"
# A "pointer" is a gitlink-mode delta (mode 160000); ordinary content
# under repos/<name>/ (books, docs, scripts) must flow freely.
pointer_staged="$(git diff --cached --raw | awk '($1 == ":160000" || $2 == "160000" || ($3 == "160000" && $4 != "000000") || ($3 != "160000" && $4 == "160000")) && $6 ~ /^repos\// {print $6}' || true)"
merge_in_progress="$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || true)"

# During a merge, inherited paths are already reviewed by one of the two
# parents. A merge may carry those paths together, but a conflict resolution
# or any newly staged unrelated path remains subject to R2/R3 purity.
merge_inherited() {
  local path="$1"
  [ -n "$merge_in_progress" ] || return 1
  git diff --cached --quiet HEAD -- "$path" && return 0
  git diff --cached --quiet "$merge_in_progress" -- "$path"
}

if [ -n "$merge_in_progress" ]; then
  unstaged_tracked="$(git diff --name-only)"
  if [ -n "$unstaged_tracked" ]; then
    echo "[pre-commit] merge purity refuses unstaged tracked content:" >&2
    printf '  %s\n' $unstaged_tracked >&2
    exit 1
  fi
fi

# Git exports GIT_DIR/GIT_INDEX_FILE/GIT_WORK_TREE to hooks; a bare
# `git -C <submodule>` then resolves against this superproject's object
# store instead of the submodule's, so every per-member ref probe below
# misfires (hephaestus's `origin/master` does not exist in the atlas repo).
# Root probes must retain the commit index, including `git commit --only`'s
# temporary index. Only member probes discard it.
unset GIT_DIR GIT_WORK_TREE

# The canonical root is resolved at most once per hook run.
stack_root=""
stack_root_resolved=0

# Sets `checkout` to the member's checkout: this tree's, else the canonical
# main tree's. Returns 1 when neither holds one.
locate_member() {
  local path="$1"
  checkout="$ROOT/$path"
  [ -e "$checkout/.git" ] && return 0
  if [ "$stack_root_resolved" = 0 ]; then
    stack_root="$(canonical_stack_root "$ROOT" 2>/dev/null)" || stack_root=""
    stack_root_resolved=1
  fi
  [ -n "$stack_root" ] || return 1
  checkout="$stack_root/$path"
  [ -e "$checkout/.git" ]
}

# Git in a member checkout, without this commit's index.
checkout_git() {
  local directory="$1" index="${GIT_INDEX_FILE-}" had_index="${GIT_INDEX_FILE+set}" status=0
  shift
  unset GIT_INDEX_FILE
  git -C "$directory" "$@" || status=$?
  [ -z "$had_index" ] || export GIT_INDEX_FILE="$index"
  return "$status"
}

# Staged gitlink coherence.
#
# A submodule's checkout in this shared tree routinely sits on a feature
# branch, and `git commit` without a pathspec records that worktree HEAD for
# every staged submodule — including ones a peer staged. Three commits on
# 2026-09-02 pinned apollo and mnemosyne to `test/apollo-stft-leto-sidecar`
# and `refactor/mnemosyne-free-helpers-split` that way. The pre-push guard
# catches it, but only once the bad pin is already in history and blocking
# someone's push, so this refuses it at the commit that creates it.
#
# The check reads the staged entry, not HEAD, which is exactly what the
# pre-push auditor cannot do.
gitlink_defect=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  entry=$(git ls-files --stage -- "$path" 2>/dev/null || true)
  read -r mode sha _ <<<"${entry%%$'\n'*}" || true
  [ "$mode" = "160000" ] || continue
  if ! locate_member "$path"; then
    echo "[pre-commit] $path: canonical member checkout is absent; gitlink not checked." >&2
    gitlink_defect=1
    continue
  fi
  default=$(checkout_git "$checkout" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
  default=${default#origin/}
  default=${default:-main}
  if ! checkout_git "$checkout" rev-parse --verify --quiet "origin/${default}" >/dev/null 2>&1; then
    echo "[pre-commit] $path: no origin/${default} locally; gitlink not checked." >&2
    continue
  fi
  if ! checkout_git "$checkout" merge-base --is-ancestor "$sha" "origin/${default}" 2>/dev/null; then
    echo "[pre-commit] $path is staged at ${sha:0:10}, which is not on origin/${default}." >&2
    echo "             A gitlink comes from the ref, never from a checkout:" >&2
    echo "               git update-index --cacheinfo 160000,\$(git -C $path rev-parse origin/${default}),$path" >&2
    gitlink_defect=1
  fi
  # Backward-pin guard (ATLAS-BACKWARD-PIN-GUARD-2026-09-02): a staged entry
  # strictly behind the pin recorded at HEAD reverts the member out of the
  # recorded stack state. The branch-tip check above asks only "is this commit
  # on the default branch?" — which a stale ancestor answers acceptably; this
  # asks the separate question "is this commit already superseded here?".
  recorded=$(git rev-parse "HEAD:$path" 2>/dev/null || true)
  if [ -n "$recorded" ] && [ "$sha" != "$recorded" ] && \
     checkout_git "$checkout" merge-base --is-ancestor "$sha" "$recorded" 2>/dev/null; then
    echo "[pre-commit] $path: staged ${sha:0:10} is behind recorded ${recorded:0:10}; refusing backward pin." >&2
    echo "  Advance from origin/${default}, never a stale checkout:" >&2
    echo "    git update-index --cacheinfo 160000,\$(git -C $path rev-parse origin/${default}),$path" >&2
    gitlink_defect=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -- 'repos/*' 2>/dev/null)
if [ "$gitlink_defect" != 0 ]; then
  echo "[pre-commit] refusing the commit: a pin the stack cannot resolve from the member's default branch breaks every consumer." >&2
  exit 1
fi

# R2 - board sync stays pure.
if [ -n "$board_staged" ]; then
  pollution="$(staged | grep -vE '^(backlog|checklist)\.md$' | grep -E '^repos/|Cargo\.lock$|^\.github/workflows/' | while IFS= read -r path; do
    [ -n "$path" ] || continue
    merge_inherited "$path" || printf '%s\n' "$path"
  done)"
  if [ -n "$pollution" ]; then
    echo "[pre-commit] R2: board sync must not carry these staged paths:" >&2
    printf '  %s\n' $pollution >&2
    echo "  Split: pointer advances and workflow changes are their own commits." >&2
    exit 1
  fi
fi

# R3 - pointer advances stay pure (content goes in sibling commits).
if [ -n "$pointer_staged" ]; then
  non_pointer="$(staged | while IFS= read -r path; do
    [ -n "$path" ] || continue
    printf '%s\n' "$pointer_staged" | grep -Fxq "$path" && continue
    merge_inherited "$path" && continue
    printf '%s\n' "$path"
  done)"
  if [ -n "$non_pointer" ]; then
    echo "[pre-commit] R3: pointer-advance commit carries non-pointer paths:" >&2
    printf '  %s\n' $non_pointer >&2
    echo "  Commit the pointer delta alone; content changes are siblings." >&2
    exit 1
  fi
fi

# Inspect the actual commit index; unrelated working-tree changes do not enter
# this commit. A historical-content match needs an explicit recorded reason.
python_bin="${PYTHON:-}"
if [ -z "$python_bin" ]; then
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1             && "$candidate" -c 'import sys' >/dev/null 2>&1; then
            python_bin="$candidate"
            break
        fi
    done
fi
if [ -z "$python_bin" ]; then
    echo "pre-commit: BLOCKED -- no working python interpreter found." >&2
    exit 1
fi
# Unused alternate indexes can retain an obsolete staging basis. Both
# checks run in one interpreter.
guard_modes=(basis)
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  guard_modes=(check basis)
fi
"$python_bin" scripts/atlas-stale-side-guard.py "${guard_modes[@]}" --staged || exit 1

# Fast-path: only run the detector when docs-relevant files are staged.
# Avoids paying the cost on every commit (e.g. pure Rust edits).
changed=$(grep -E '^repos/[^/]+/docs/book/|^scripts/check_mdbook_links\.py|^\.github/workflows/docs\.yml$|^\.githooks/pre-commit$' \
  <<<"$staged_paths" || true)
if [ -n "$changed" ]; then
echo "[pre-commit] Atlas docs dead-link check (§7 #5, STRICT mode — blocks commits with FILE_MISSING > 0)…"

# §7 #5 LANDED: --advisory removed.  The detector's exit-1 on
# FILE_MISSING > 0 IS the strict gate; every provider book must reach
# `FILE_MISSING : 0` for this hook to pass.  See
# docs/mdbook/detector-parity.md §7 #5 for the flip rationale.
#
# The glob mirrors .github/workflows/docs.yml — keep the two in step. A book
# added to one and not the other is a silently ungated book; the glob means
# new provider books are gated by both automatically.  Read each staged
# gitlink object instead of a member working tree: linked lanes normally leave
# those directories uninitialized, and a canonical checkout can carry
# unrelated work in progress.
book_roots=()
book_archive_dir="$(mktemp -d)" || exit 1
trap 'rm -rf "$book_archive_dir"' EXIT
while IFS=$'\t' read -r mode sha path; do
  [ "$mode" = "160000" ] || continue
  member_root="$book_archive_dir/${path#repos/}"
  mkdir -p "$member_root"
  if ! locate_member "$path" || ! checkout_git "$checkout" archive --format=tar "$sha" > "$member_root/member.tar"; then
    echo "[pre-commit] $path: cannot archive staged gitlink ${sha:0:10} for book checks." >&2
    exit 1
  fi
  if ! tar -xf "$member_root/member.tar" -C "$member_root"; then
    echo "[pre-commit] $path: cannot extract staged gitlink ${sha:0:10} for book checks." >&2
    exit 1
  fi
  rm -f "$member_root/member.tar"
  book="$member_root/docs/book"
  [ -d "$book" ] && book_roots+=("$book")
done < <(git ls-files --stage | awk '$1 == "160000" {print $1 "\t" $2 "\t" $4}')
if [ "${#book_roots[@]}" -eq 0 ]; then
  echo "[pre-commit] no provider book roots are present in staged gitlinks." >&2
  exit 1
fi
"$python_bin" scripts/check_mdbook_links.py "${book_roots[@]}"
fi

# Atlas provider-integration closure guard.
#
# Provider configuration and gate changes require their own check, independent
# of whether the same commit changes book content.
integration_changed=$(grep -E '^\.gitmodules$|^\.githooks/pre-commit$|^scripts/atlas-provider-integration-audit\.py$|^scripts/atlas-version-guard-sweep\.py$|^scripts/tests/test_atlas_provider_integration_audit\.py$|^scripts/tests/test_atlas_version_guard_sweep\.py$|^\.github/workflows/version-guard\.yml$' \
  <<<"$staged_paths" || true)
if [ -n "$integration_changed" ]; then
  echo "[pre-commit] Atlas provider integration closure guard…"
  "$python_bin" scripts/atlas-provider-integration-audit.py --structural-only --staged
fi

exit 0
