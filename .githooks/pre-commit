#!/usr/bin/env bash
#
# Atlas docs dead-link check (STRICT mode, §7 #5 LANDED).
#
# Scans repos/{CFDrs,helios,kwavers,ritk}/docs/book/ for broken inline links via
# scripts/check_mdbook_links.py.  Exits non-zero on any FILE_MISSING —
# BLOCKS commits that introduce new broken links.  See
# MDBOOK_DETECTOR_PARITY.md §7 #5 for the flip rationale.
#
# This hook is version-controlled so every clone runs the same gate. Enable it
# once per clone with:
#
#   git config core.hooksPath .githooks
#
# A hook kept only in .git/hooks/ is local to one machine, so a fix to it
# reaches nobody. Keep this file as the single source and never edit the copy
# under .git/hooks/.

set -e

# Locate the work-tree root.  Skip cleanly if no git context (e.g. dry-run).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  echo "[pre-commit] not inside a git work-tree; skipping docs check" >&2
  exit 0
fi
cd "$ROOT"

# Fast-path: only run the detector when docs-relevant files are staged.
# Avoids paying the cost on every commit (e.g. pure Rust edits).
changed=$(git diff --cached --name-only 2>/dev/null \
  | grep -E '^repos/(CFDrs|helios|kwavers|ritk)/docs/book/|^scripts/check_mdbook_links\.py|^\.github/workflows/docs\.yml$|^\.githooks/pre-commit$' \
  || true)
if [ -z "$changed" ]; then
  exit 0
fi

echo "[pre-commit] Atlas docs dead-link check (§7 #5, STRICT mode — blocks commits with FILE_MISSING > 0)…"

# §7 #5 LANDED: --advisory removed.  The detector's exit-1 on
# FILE_MISSING > 0 IS the strict gate; all 4 books must reach
# `FILE_MISSING : 0` for this hook to pass.  See
# MDBOOK_DETECTOR_PARITY.md §7 #5 for the flip rationale.
#
# Book list mirrors .github/workflows/docs.yml — keep the two in step. A book
# added to one and not the other is a silently ungated book.
python3 scripts/check_mdbook_links.py \
  repos/CFDrs/docs/book \
  repos/helios/docs/book \
  repos/kwavers/docs/book \
  repos/ritk/docs/book

exit 0
